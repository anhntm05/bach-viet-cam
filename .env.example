# Backend Configuration
PORT=8000
NODE_ENV=production
APP_ORIGIN=http://localhost:3000

# Database URL
# Note: Inside Docker container, host.docker.internal points to the host machine's localhost
DATABASE_URL=postgresql://anhnlh:Bvc%40123@host.docker.internal:5432/bachvietcam_staging

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000/api

# RabbitMQ Cloud used by rhythm-service
RHYTHM_SERVICE_RABBITMQ_URL=amqps://user:password@your-rabbitmq-cloud-host/vhost
RHYTHM_SERVICE_INTERNAL_API_KEY=replace-with-a-long-random-value

# Rhythm service database
RHYTHM_SERVICE_DB_USER=rhythm
RHYTHM_SERVICE_DB_PASSWORD=change-this-password
RHYTHM_SERVICE_DB_NAME=rhythm

# Gemini feedback for rhythm-service
RHYTHM_SERVICE_GEMINI_API_KEY=
RHYTHM_SERVICE_GEMINI_MODEL=gemini-3.6-flash
RHYTHM_SERVICE_GEMINI_TIMEOUT_SECONDS=500
